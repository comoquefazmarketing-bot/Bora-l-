import express from "express";
import cors from "cors";

const app = express();
app.use(cors()); // ok para DEV local; em produÃ§Ã£o, restrinja para seu domÃ­nio
app.use(express.json({ limit: "2mb" }));

const N8N_WEBHOOK = "https://showers-faulkio-stephen.trycloudflare.com/webhook-test/conversa-lia";

app.get("/health", (_, res) => res.json({ ok: true }));

app.post("/api/chat", async (req, res) => {
  try {
    const { chatInput, sessionId } = req.body || {};

    if (!chatInput || typeof chatInput !== "string") {
      return res.status(400).json({ output: "Envie chatInput (string) no body." });
    }

    const payload = {
      chatInput,
      sessionId: sessionId || "web_default"
    };

    const r = await fetch(N8N_WEBHOOK, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    const text = await r.text();

    if (!r.ok) {
      return res.status(r.status).json({
        output: "Erro ao falar com o n8n.",
        status: r.status,
        raw: text.slice(0, 500),
      });
    }

    // n8n pode retornar JSON ou texto; tentamos JSON primeiro
    let data;
    try {
      data = JSON.parse(text);
    } catch {
      // Se vier texto puro, devolve como output
      return res.json({ output: text });
    }

    const obj = Array.isArray(data) ? (data[0] || {}) : (data || {});
    const output = obj.output || obj.text || obj.message || text;

    return res.json({ output, raw: obj });

  } catch (e) {
    return res.status(500).json({
      output: "Falha interna na API.",
      error: String(e?.message || e),
    });
  }
});

const PORT = process.env.PORT || 3001;
app.listen(PORT, () => console.log("API Bora La rodando em http://localhost:" + PORT));