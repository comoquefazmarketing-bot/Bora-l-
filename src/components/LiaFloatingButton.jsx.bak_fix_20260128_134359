import React, { useState, useEffect, useRef } from 'react';
import { Send, X } from 'lucide-react';

export default function LiaFloatingButton() {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState([
    { role: 'lia', text: 'Oi! Sou a Karen. Agora a conexão está certa! Mande um oi para o n8n.' }
  ]);
  const [input, setInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const scrollRef = useRef();

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  const handleSend = async () => {
    if (!input.trim()) return;
    const userText = input;
    setMessages(prev => [...prev, { role: 'user', text: userText }]);
    setInput('');
    setIsTyping(true);

    try {
      // URL CORRIGIDA PARA O SEU TÚNEL ATUAL
      const response = await fetch('https://showers-faulkio-stephen.trycloudflare.com/webhook-test/conversa-lia', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          chatInput: userText,
          sessionId: "Felipe_Final_Sync"
        })
      });

      if (!response.ok) throw new Error();

      const data = await response.json();
      const result = Array.isArray(data) ? data[0] : data;
      const botReply = result.output || result.text || "Conectado com sucesso!";

      setMessages(prev => [...prev, { role: 'lia', text: botReply }]);
    } catch (e) {
      setMessages(prev => [...prev, { 
        role: 'lia', 
        text: 'O sinal saiu do app, mas o n8n não respondeu. Verifique se o botão Listen for test event ainda está ativo!' 
      }]);
    } finally {
      setIsTyping(false);
    }
  };

  return (
    <div className="fixed bottom-6 right-6 z-[10000] flex flex-col items-end font-sans">
      {isOpen && (
        <div className="mb-4 w-[350px] h-[520px] bg-white rounded-[32px] shadow-2xl border border-black/5 flex flex-col overflow-hidden">
          <div className="p-5 bg-slate-900 text-white flex items-center justify-between">
            <div className="flex items-center gap-3">
              <img src="/Lia.jpeg" className="w-12 h-12 rounded-full border-2 border-[#00BFA6] object-cover" />
              <div>
                <p className="font-black italic uppercase text-sm leading-none">Karen AI</p>
                <span className="text-[10px] text-[#00BFA6] font-bold uppercase animate-pulse mt-1 block tracking-tighter">● Sincronizada</span>
              </div>
            </div>
            <button onClick={() => setIsOpen(false)} className="p-2 hover:bg-white/10 rounded-full"><X size={22}/></button>
          </div>
          <div className="flex-1 overflow-y-auto p-5 space-y-4 bg-[#FDFCFB]">
            {messages.map((m, i) => (
              <div key={i} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                <div className={`max-w-[85%] p-3.5 rounded-[22px] text-sm font-medium shadow-sm ${m.role === 'user' ? 'bg-[#00BFA6] text-black' : 'bg-white border text-slate-700'}`}>
                  {m.text}
                </div>
              </div>
            ))}
            {isTyping && <div className="text-[10px] text-[#00BFA6] font-bold animate-pulse px-2 uppercase">Karen pensando...</div>}
            <div ref={scrollRef} />
          </div>
          <div className="p-4 bg-white border-t">
            <div className="flex gap-2 bg-slate-100 rounded-full px-4 py-2">
              <input value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={(e) => e.key === 'Enter' && handleSend()} placeholder="Fale com a Karen..." className="flex-1 bg-transparent text-sm outline-none text-slate-700" />
              <button onClick={handleSend} className="text-[#00BFA6] p-1"><Send size={20} fill="currentColor" /></button>
            </div>
          </div>
        </div>
      )}
      <button onClick={() => setIsOpen(!isOpen)} className="w-16 h-16 rounded-full bg-white border-4 border-[#00BFA6] shadow-2xl overflow-hidden active:scale-95 transition-all">
        <img src="/Lia.jpeg" className="w-full h-full object-cover" alt="Karen" />
      </button>
    </div>
  );
}